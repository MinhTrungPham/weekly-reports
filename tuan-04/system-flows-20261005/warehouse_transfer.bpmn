point x="2495" y="567"/><bpmndi:BPMNLabel><dc:Bounds x="2435" y="542" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9"><di:waypoint x="2720" y="567"/><di:waypoint x="2780" y="567"/><bpmndi:BPMNLabel><dc:Bounds x="2720" y="542" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10"><di:waypoint x="810" y="575"/><di:waypoint x="810" y="268"/><di:waypoint x="875" y="268"/><bpmndi:BPMNLabel><dc:Bounds x="810" y="243" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_11" bpmnElement="Flow_11"><di:waypoint x="997.5" y="300"/><di:waypoint x="997.5" y="680"/><di:waypoint x="327.5" y="680"/><di:waypoint x="327.5" y="229"/><bpmndi:BPMNLabel><dc:Bounds x="997.5" y="655" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_12" bpmnElement="Flow_12"><di:waypoint x="1665" y="575"/><di:waypoint x="1665" y="268"/><di:waypoint x="1730" y="268"/><bpmndi:BPMNLabel><dc:Bounds x="1665" y="243" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_13" bpmnElement="Flow_13"><di:waypoint x="1852.5" y="300"/><di:waypoint x="1852.5" y="658"/><di:waypoint x="1182.5" y="658"/><di:waypoint x="1182.5" y="229"/><bpmndi:BPMNLabel><dc:Bounds x="1852.5" y="633" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>