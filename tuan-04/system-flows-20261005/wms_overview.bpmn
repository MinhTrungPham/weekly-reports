<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_wms_overview" targetNamespace="https://laztar/wms/design"><bpmn:collaboration id="Collaboration_wms_overview"><bpmn:participant id="Pool_wms_overview" name="BPMN — Toàn cảnh ứng dụng WMS" processRef="Process_wms_overview"/></bpmn:collaboration><bpmn:process id="Process_wms_overview" isExecutable="false"><bpmn:documentation>Một phiên làm việc: chọn một chức năng độc lập, xử lý rồi trở về. Không phải chuỗi bắt buộc Nhập → Xuất → Kiểm kê.
Mỗi call activity được phân rã trong file BPMN cùng tên; auth/permission/scope vẫn được kiểm tra tại API từng chức năng.
Đây là bản thiết kế theo tài liệu: chi tiết TRANSIT, FEFO và vòng đời chứng từ Outbound chưa được chốt hoàn toàn.</bpmn:documentation><bpmn:laneSet id="Lanes_wms_overview"><bpmn:lane id="Lane_0" name="Người dùng + WMS"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Access</bpmn:flowNodeRef><bpmn:flowNodeRef>Select</bpmn:flowNodeRef><bpmn:flowNodeRef>Master</bpmn:flowNodeRef><bpmn:flowNodeRef>Inbound</bpmn:flowNodeRef><bpmn:flowNodeRef>Outbound</bpmn:flowNodeRef><bpmn:flowNodeRef>Transfer</bpmn:flowNodeRef><bpmn:flowNodeRef>Count</bpmn:flowNodeRef><bpmn:flowNodeRef>Adjust</bpmn:flowNodeRef><bpmn:flowNodeRef>Lookup</bpmn:flowNodeRef><bpmn:flowNodeRef>Reversal</bpmn:flowNodeRef><bpmn:flowNodeRef>Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>Continue</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Mở ứng dụng"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:callActivity id="Access" name="Xác thực / phân quyền access_rbac.bpmn"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:callActivity><bpmn:exclusiveGateway id="Select" name="Chọn chức năng"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:callActivity id="Master" name="Quản trị / danh mục master_data.bpmn"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:callActivity><bpmn:callActivity id="Inbound" name="Nhập hàng / cất hàng inbound_putaway.bpmn"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:callActivity><bpmn:callActivity id="Outbound" name="Xuất hàng outbound_shipping.bpmn"><bp