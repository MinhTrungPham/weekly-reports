<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_lookup_reporting" targetNamespace="https://laztar/wms/design"><bpmn:collaboration id="Collaboration_lookup_reporting"><bpmn:participant id="Pool_lookup_reporting" name="BPMN — Tra cứu tồn, sổ cái và mã hàng" processRef="Process_lookup_reporting"/></bpmn:collaboration><bpmn:process id="Process_lookup_reporting" isExecutable="false"><bpmn:documentation>Bao phủ Viewer và người vận hành; QR là tem SKU/UOM, không tự chứa lot/expiry khi payload chưa thiết kế.
Tra cứu không tạo movement. QR render ở UI hoặc dịch vụ QR theo contract; không bắt buộc Cloudinary.
Dữ liệu row available khác tổng sellable: row QC vẫn có on_hand, nhưng không được cộng vào tổng pickable.
Viewer xem ledger hay không phụ thuộc permission catalog được team chốt; không suy ra từ tên role.</bpmn:documentation><bpmn:laneSet id="Lanes_lookup_reporting"><bpmn:lane id="Lane_0" name="Viewer / nhân viên kho"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Query</bpmn:flowNodeRef><bpmn:flowNodeRef>Display</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Hệ thống BE"><bpmn:flowNodeRef>AuthQuery</bpmn:flowNodeRef><bpmn:flowNodeRef>Compute</bpmn:flowNodeRef><bpmn:flowNodeRef>Respond</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="DB danh mục / tồn / ledger"><bpmn:flowNodeRef>ReadQuery</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Bắt đầu"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Query" name="Chọn kho/SKU/vị trí Bộ lọc / phân trang / barcode Hoặc yêu cầu tem QR SKU/UOM"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AuthQuery" name="Xác thực + quyền đọc Tồn/ledger theo scope kho Danh mục chung theo policy"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="ReadQuery" name="Đọc inventory / locations SKU/UOM/conversion/barcode Ledger nếu có quyền"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Compute" name="Detail: on_hand - reserved Summary: chỉ BIN is_pickable Loại QC/DAMAGED"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Respond" name="Trả ID/Decimal string DATE YYYY-MM-DD; timestamp UTC Kết quả / meta / lỗi"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Display" name="Xem / đối soát tồn và ledger Render QR, in tem nếu có dữ liệu"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="End" name="Hoàn tất"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Query" name=""/><bpmn:sequenceFlow id="Flow_1" sourceRef="Query" targetRef="AuthQuery" name=""/><bpmn:sequenceFlow id="Flow_2" sourceRef="AuthQuery" targetRef="ReadQuery" name=""/><bpmn:sequenceFlow id="Flow_3" sourceRef="ReadQuery" targetRef="Compute" name=""/><bpmn:sequenceFlow id="Flow_4" sourceRef="Compute" targetRef="Respond" name=""/><bpmn:sequenceFlow id="Flow_5" sourceRef="Respond" targetRef="Display" name=""/><bpmn:sequenceFlow id="Flow_6" sourceRef="Display" targetRef="End" name=""/></bpmn:process><bpmndi:BPMNDiagram id="Diagram_lookup_reporting"><bpmndi:BPMNPlane id="Plane_lookup_reporting" bpmnElement="Collaboration_lookup_reporting"><bpmndi:BPMNShape id="Shape_Pool" bpmnElement="Pool_lookup_reporting" isHorizontal="true"><dc:Bounds x="0" y="115" width="2145" height="570"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_0" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="30" y="115" width="2115" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_1" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="30" y="305" width="2115" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_2" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="30" y="495" width="2115" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="140" y="175" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="95" y="216" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Query" bpmnElement="Query"><dc:Bounds x="215" y="145" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_AuthQuery" bpmnElement="AuthQuery"><dc:Bounds x="500" y="335" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_ReadQuery" bpmnElement="ReadQuery"><dc:Bounds x="785" y="525" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Compute" bpmnElement="Compute"><dc:Bounds x="1070" y="335" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Respond" bpmnElement="Respond"><dc:Bounds x="1355" y="335" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Display" bpmnElement="Display"><dc:Bounds x="1640" y="145" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_End" bpmnElement="End"><dc:Bounds x="1925" y="169" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1880" y="210" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0"><di:waypoint x="176" y="193"/><di:waypoint x="195.5" y="193"/><di:waypoint x="195.5" y="187"/><di:waypoint x="215" y="187"/><bpmndi:BPMNLabel><dc:Bounds x="195.5" y="168" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1"><di:waypoint x="440" y="187"/><di:waypoint x="470" y="187"/><di:waypoint x="470" y="377"/><di:waypoint x="500" y="377"/><bpmndi:BPMNLabel><dc:Bounds x="470" y="162" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2"><di:waypoint x="725" y="377"/><di:waypoint x="755" y="377"/><di:waypoint x="755" y="567"/><di:waypoint x="785" y="567"/><bpmndi:BPMNLabel><dc:Bounds x="755" y="352" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3"><di:waypoint x="1010" y="567"/><di:waypoint x="1040" y="567"/><di:waypoint x="1040" y="377"/><di:waypoint x="1070" y="377"/><bpmndi:BPMNLabel><dc:Bounds x="1040" y="542" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4"><di:waypoint x="1295" y="377"/><di:waypoint x="1355" y="377"/><bpmndi:BPMNLabel><dc:Bounds x="1295" y="352" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5"><di:waypoint x="1580" y="377"/><di:waypoint x="1610" y="377"/><di:waypoint x="1610" y="187"/><di:waypoint x="1640" y="187"/><bpmndi:BPMNLabel><dc:Bounds x="1610" y="352" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6"><di:waypoint x="1865" y="187"/><di:waypoint x="1925" y="187"/><bpmndi:BPMNLabel><dc:Bounds x="1865" y="162" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>