<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_cycle_count_inspection" targetNamespace="https://laztar/wms/design"><bpmn:collaboration id="Collaboration_cycle_count_inspection"><bpmn:participant id="Pool_cycle_count_inspection" name="BPMN — Kiểm kê và kiểm tra chất lượng" processRef="Process_cycle_count_inspection"/></bpmn:collaboration><bpmn:process id="Process_cycle_count_inspection" isExecutable="false"><bpmn:documentation>Luồng team theo tài liệu mới; nối sang BPMN Adjustment. Không tự sửa inventory từ kết quả đếm.
Nếu không chênh lệch: hoàn tất kiểm kê, tồn/ledger không đổi. Review count không đồng nghĩa approve adjustment.
Schema/DTO Cycle Count phải thống nhất identity và thời điểm snapshot; chưa mặc định code đã đáp ứng.
Quarantine/QC/DAMAGED là bước thiết kế bổ sung nếu có chuyển hàng; muốn đổi vị trí phải dùng movement hợp lệ.</bpmn:documentation><bpmn:laneSet id="Lanes_cycle_count_inspection"><bpmn:lane id="Lane_0" name="Supervisor"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>CreateCount</bpmn:flowNodeRef><bpmn:flowNodeRef>ReviewCount</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Inspector"><bpmn:flowNodeRef>Count</bpmn:flowNodeRef><bpmn:flowNodeRef>Proposal</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Hệ thống BE + DB"><bpmn:flowNodeRef>ValidateCount</bpmn:flowNodeRef><bpmn:flowNodeRef>AssignCount</bpmn:flowNodeRef><bpmn:flowNodeRef>SubmitCount</bpmn:flowNodeRef><bpmn:flowNodeRef>Difference</bpmn:flowNodeRef><bpmn:flowNodeRef>Exception_0</bpmn:flowNodeRef><bpmn:flowNodeRef>EndException_0</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Bắt đầu"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="CreateCount" name="Tạo phiên kiểm kê Kho, BIN/SKU; giao Inspector"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="ValidateCount" name="Quyền/scope; assignee ACTIVE Đọc inventoryId/lot/serial Chốt thời điểm snapshot"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="AssignCount" name="Lưu phiên + danh sách dòng Snapshot qty/version Giao việc"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Count" name="Đếm thực tế base UOM Kiểm tra lot/expiry/chất lượng Ghi nhận theo dòng tồn"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="SubmitCount" name="Nộp kết quả; kiểm tra owner Tính chênh lệch so snapshot Lưu kết quả; không ghi ledger"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Difference" name="Có chênh lệch?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Proposal" name="Inspector tạo Adjustment inventoryId + actualQty + reason Theo BPMN Điều chỉnh"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="ReviewCount" name="Theo dõi kết quả / xử lý Chất lượng là hồ sơ riêng Duyệt tồn qua Adjustment"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="End" name="Hoàn tất"><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="Exception_0" name="Hoàn tất kiểm kê Không tạo Adjustment"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="EndException_0" name="Khớp tồn"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="CreateCount" name=""/><bpmn:sequenceFlow id="Flow_1" sourceRef="CreateCount" targetRef="ValidateCount" name=""/><bpmn:sequenceFlow id="Flow_2" sourceRef="ValidateCount" targetRef="AssignCount" name=""/><bpmn:sequenceFlow id="Flow_3" sourceRef="AssignCount" targetRef="Count" name=""/><bpmn:sequenceFlow id="Flow_4" sourceRef="Count" targetRef="SubmitCount" name=""/><bpmn:sequenceFlow id="Flow_5" sourceRef="SubmitCount" targetRef="Difference" name=""/><bpmn:sequenceFlow id="Flow_6" sourceRef="Difference" targetRef="Proposal" name="Có"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Proposal" targetRef="ReviewCount" name=""/><bpmn:sequenceFlow id="Flow_8" sourceRef="ReviewCount" targetRef="End" name=""/><bpmn:sequenceFlow id="Flow_9" sourceRef="Difference" targetRef="Exception_0" name="Không"/><bpmn:sequenceFlow id="Flow_10" sourceRef="Exception_0" targetRef="EndException_0" name=""/></bpmn:process><bpmndi:BPMNDiagram id="Diagram_cycle_count_inspection"><bpmndi:BPMNPlane id="Plane_cycle_count_inspection" bpmnElement="Collaboration_cycle_count_inspection"><bpmndi:BPMNShape id="Shape_Pool" bpmnElement="Pool_cycle_count_inspection" isHorizontal="true"><dc:Bounds x="0" y="115" width="2715" height="570"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_0" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="30" y="115" width="2685" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_1" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="30" y="305" width="2685" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_2" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="30" y="495" width="2685" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="140" y="175" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="95" y="216" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_CreateCount" bpmnElement="CreateCount"><dc:Bounds x="215" y="145" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_ValidateCount" bpmnElement="ValidateCount"><dc:Bounds x="500" y="525" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_AssignCount" bpmnElement="AssignCount"><dc:Bounds x="785" y="525" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Count" bpmnElement="Count"><dc:Bounds x="1070" y="335" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_SubmitCount" bpmnElement="SubmitCount"><dc:Bounds x="1355" y="525" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Difference" bpmnElement="Difference" isMarkerVisible="true"><dc:Bounds x="1640" y="525" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1595" y="500" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Proposal" bpmnElement="Proposal"><dc:Bounds x="1925" y="335" width="225" height="84"/></bpmndi: