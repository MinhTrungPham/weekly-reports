<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_access_rbac" targetNamespace="https://laztar/wms/design"><bpmn:collaboration id="Collaboration_access_rbac"><bpmn:participant id="Pool_access_rbac" name="BPMN — Đăng nhập, token và phân quyền" processRef="Process_access_rbac"/></bpmn:collaboration><bpmn:process id="Process_access_rbac" isExecutable="false"><bpmn:documentation>Áp dụng cho mọi role. Mỗi API bảo vệ kiểm tra lại user ACTIVE và assignment/role ACTIVE.
Thiếu/sai/hết hạn/sai loại token: 401; thiếu permission hoặc scope: 403. Refresh không tự thu hồi token cũ.
Login/refresh là xác thực; gán role yêu cầu ADMIN toàn hệ thống theo policy code hiện tại.</bpmn:documentation><bpmn:laneSet id="Lanes_access_rbac"><bpmn:lane id="Lane_0" name="Người dùng"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Login</bpmn:flowNodeRef><bpmn:flowNodeRef>Request</bpmn:flowNodeRef><bpmn:flowNodeRef>Exception_0</bpmn:flowNodeRef><bpmn:flowNodeRef>Exception_1</bpmn:flowNodeRef><bpmn:flowNodeRef>EndException_1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Hệ thống BE"><bpmn:flowNodeRef>CheckIdentity</bpmn:flowNodeRef><bpmn:flowNodeRef>LoginOK</bpmn:flowNodeRef><bpmn:flowNodeRef>Tokens</bpmn:flowNodeRef><bpmn:flowNodeRef>Verify</bpmn:flowNodeRef><bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef><bpmn:flowNodeRef>Execute</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="DB / RBAC"><bpmn:flowNodeRef>Permission</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Bắt đầu"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Login" name="Nhập username hoặc email Và password"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="CheckIdentity" name="Tìm account; kiểm tra hash Chặn inactive/locked Định danh mơ hồ → 401"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="LoginOK" name="Đăng nhập đúng?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Tokens" name="Cấp access + refresh Claim tokenType; secret riêng"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Request" name="Gọi API với access token Hoặc refresh khi hết hạn"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Verify" name="Verify signature/expiry/type Refresh: user ACTIVE → token API: đọc user/role/permission"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Permission" name="Permission và scope kho Trên cùng assignment active Đọc kho từ bản ghi thực tế"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Allowed" name="Được phép?"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Execute" name="Thực thi nghiệp vụ Ghi actor/audit từ user Trả response / lỗi nghiệp vụ"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End" name="Hoàn tất"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Exception_0" name="401 chung Sửa thông tin đăng nhập"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Exception_1" name="401 hoặc 403 Không chạy nghiệp vụ"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="EndException_1" name="Từ chối"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Login" name=""/><bpmn:sequenceFlow id="Flow_1" sourceRef="Login" targetRef="CheckIdentity" name=""/><bpmn:sequenceFlow id="Flow_2" sourceRef="CheckIdentity" targetRef="LoginOK" name=""/><bpmn:sequenceFlow id="Flow_3" sourceRef="LoginOK" targetRef="Tokens" name="Có"/><bpmn:sequenceFlow id="Flow_4" sourceRef="Tokens" targetRef="Request" name=""/><bpmn:sequenceFlow id="Flow_5" sourceRef="Request" targetRef="Verify" name=""/><bpmn:sequenceFlow id="Flow_6" sourceRef="Verify" targetRef="Permission" name=""/><bpmn:sequenceFlow id="Flow_7" sourceRef="Permission" targetRef="Allowed" name=""/><bpmn:sequenceFlow id="Flow_8" sourceRef="Allowed" targetRef="Execute" name="Có"/><bpmn:sequenceFlow id="Flow_9" sourceRef="Execute" targetRef="End" name=""/><bpmn:sequenceFlow id="Flow_10" sourceRef="LoginOK" targetRef="Exception_0" name="Không"/><bpmn:sequenceFlow id="Flow_11" sourceRef="Exception_0" targetRef="Login" name="Xử lý / thử lại"/><bpmn:sequenceFlow id="Flow_12" sourceRef="Allowed" targetRef="Exception_1" name="Không"/><bpmn:sequenceFlow id="Flow_13" sourceRef="Exception_1" targetRef="EndException_1" name=""/></bpmn:process><bpmndi:BPMNDiagram id="Diagram_access_rbac"><bpmndi:BPMNPlane id="Plane_access_rbac" bpmnElement="Collaboration_access_rbac"><bpmndi:BPMNShape id="Shape_Pool" bpmnElement="Pool_access_rbac" isHorizontal="true"><dc:Bounds x="0" y="115" width="3000" height="570"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_0" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="30" y="115" width="2970" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_1" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="30" y="305" width="2970" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_2" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="30" y="495" width="2970" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="140" y="175" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="95" y="216" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Login" bpmnElement="Login"><dc:Bounds x="215" y="145" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_CheckIdentity" bpmnElement="CheckIdentity"><dc:Bounds x="500" y="335" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_LoginOK" bpmnElement="LoginOK" isMarkerVisible="true"><dc:Bounds x="785" y="335" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="740" y="310" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape