<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_outbound_shipping" targetNamespace="https://laztar/wms/design"><bpmn:collaboration id="Collaboration_outbound_shipping"><bpmn:participant id="Pool_outbound_shipping" name="BPMN — Xuất hàng: Reserve, Pick và Ship" processRef="Process_outbound_shipping"/></bpmn:collaboration><bpmn:process id="Process_outbound_shipping" isExecutable="false"><bpmn:documentation>LUỒNG THIẾT KẾ. Tài liệu có PICK_OUT/PICK_IN/SHIP; chưa khẳng định đã có đủ API.
Pick là chuyển vị trí: tổng kho không đổi. Ship trừ STAGING: tổng kho giảm đúng lượng giao.
Thiếu hàng: báo Supervisor, không tự ghi đủ. Partial/cancel, chọn lô và FEFO cần contract riêng.
Tài liệu kiểm thử ghi “PICK/SHIP -30” còn mơ hồ; sơ đồ chọn phân tách theo movement types và ghi chú này.</bpmn:documentation><bpmn:laneSet id="Lanes_outbound_shipping"><bpmn:lane id="Lane_0" name="Supervisor / người điều phối"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Order</bpmn:flowNodeRef><bpmn:flowNodeRef>Assign</bpmn:flowNodeRef><bpmn:flowNodeRef>Exception_0</bpmn:flowNodeRef><bpmn:flowNodeRef>Exception_1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Picker / người xác nhận xuất"><bpmn:flowNodeRef>Pick</bpmn:flowNodeRef><bpmn:flowNodeRef>ShipInput</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Hệ thống BE + DB"><bpmn:flowNodeRef>Validate</bpmn:flowNodeRef><bpmn:flowNodeRef>Enough</bpmn:flowNodeRef><bpmn:flowNodeRef>Reserve</bpmn:flowNodeRef><bpmn:flowNodeRef>Picked</bpmn:flowNodeRef><bpmn:flowNodeRef>PickTx</bpmn:flowNodeRef><bpmn:flowNodeRef>ShipTx</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Bắt đầu"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Order" name="Tạo yêu cầu xuất SKU, base qty, kho"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Validate" name="Quyền/scope; đọc tồn khả dụng Chỉ BIN is_pickable Không chọn QC/DAMAGED"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Enough" name="Đủ tồn?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Reserve" name="Tx giữ chỗ theo dòng tồn reserved += qty; version tăng Không ghi stock ledger"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Assign" name="Giao task cho Picker Đúng kho, ACTIVE"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Pick" name="Nhận task, quét/lấy hàng Báo số thực lấy / shortage"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Picked" name="Đủ lượng đã giao?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="PickTx" name="Tx: STORAGE → STAGING PICK_OUT / PICK_IN Giảm reserved nguồn cùng tx"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="ShipInput" name="Xác nhận giao/xuất Người có quyền SHIP tương ứng"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="ShipTx" name="Tx: SHIP trừ STAGING Ghi ledger + trạng thái xuất Không trừ STORAGE lần hai"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End" name="Hoàn tất"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Exception_0" name="Báo thiếu tồn Điều chỉnh đơn / chờ bổ sung"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Exception_1" name="Ghi nhận shortage Supervisor xử lý lại task"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask><bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Order" name=""/><bpmn:sequenceFlow id="Flow_1" sourceRef="Order" targetRef="Validate" name=""/><bpmn:sequenceFlow id="Flow_2" sourceRef="Validate" targetRef="Enough" name=""/><bpmn:sequenceFlow id="Flow_3" sourceRef="Enough" targetRef="Reserve" name="Có"/><bpmn:sequenceFlow id="Flow_4" sourceRef="Reserve" targetRef="Assign" name=""/><bpmn:sequenceFlow id="Flow_5" sourceRef="Assign" targetRef="Pick" name=""/><bpmn:sequenceFlow id="Flow_6" sourceRef="Pick" targetRef="Picked" name=""/><bpmn:sequenceFlow id="Flow_7" sourceRef="Picked" targetRef="PickTx" name="Có"/><bpmn:sequenceFlow id="Flow_8" sourceRef="PickTx" targetRef="ShipInput" name=""/><bpmn:sequenceFlow id="Flow_9" sourceRef="ShipInput" targetRef="ShipTx" name=""/><bpmn:sequenceFlow id="Flow_10" sourceRef="ShipTx" targetRef="End" name=""/><bpmn:sequenceFlow id="Flow_11" sourceRef="Enough" targetRef="Exception_0" name="Không"/><bpmn:sequenceFlow id="Flow_12" sourceRef="Exception_0" targetRef="Order" name="Xử lý / thử lại"/><bpmn:sequenceFlow id="Flow_13" sourceRef="Picked" targetRef="Exception_1" name="Không"/><bpmn:sequenceFlow id="Flow_14" sourceRef="Exception_1" targetRef="Assign" name="Xử lý / thử lại"/></bpmn:process><bpmndi:BPMNDiagram id="Diagram_outbound_shipping"><bpmndi:BPMNPlane id="Plane_outbound_shipping" bpmnElement="Collaboration_outbound_shipping"><bpmndi:BPMNShape id="Shape_Pool" bpmnElement="Pool_outbound_shipping" isHorizontal="true"><dc:Bounds x="0" y="115" width="3285" height="570"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_0" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="30" y="115" width="3255" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_1" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="30" y="305" width="3255" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_2" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="30" y="495" width="3255" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="140" y="175" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="95" y="216" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Order" bpmnElement="Order"><dc:Bounds x="215" y="145" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Validate"><dc:Bounds x="500" y="525" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Enough" bpmnElement="Enough" isMarkerVisible="true"><dc:Bounds x="785" y="525" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="740" y="500" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Reserve" bpmnElement="Reserve"><dc:Bounds x="1070" y="525" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Assign" bpmnElement="Assign"><dc:Bounds x="1355" y="145" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Pick" bpmnElement="Pick"><dc:Bounds x="1640" y="335" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Picked" bpmnElement="Picked" isMarkerVisible="true"><dc:Bounds x="1925" y="525" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1880" y="500" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_PickTx" bpmnElement="PickTx"><dc:Bounds x="2210" y="525" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_ShipInput" bpmnElement="ShipInput"><dc:Bounds x="2495" y="335" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_ShipTx" bpmnElement="ShipTx"><dc:Bounds x="2780" y="525" width="225" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_End" bpmnElement="End"><dc:Bounds x="3065" y="549" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="3020" y="590" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Exception_0" bpmnElement="Exception_0"><dc:Bounds x="875" y="235" width="245" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Exception_1" bpmnElement="Exception_1"><dc:Bounds x="2015" y="235" width="245" height="65"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0"><di:waypoint x="176" y="193"/><di:waypoint x="195.5" y="193"/><di:waypoint x="195.5" y="187"/><di:waypoint x="215" y="187"/><bpmndi:BPMNLabel><dc:Bounds x="195.5" y="168" width="180" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmnd