<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_adjustment_approval" targetNamespace="https://laztar/wms/design"><bpmn:collaboration id="Collaboration_adjustment_approval"><bpmn:participant id="Pool_adjustment_approval" name="BPMN — Điều chỉnh tồn kho có phê duyệt" processRef="Process_adjustment_approval"/></bpmn:collaboration><bpmn:process id="Process_adjustment_approval" isExecutable="false"><bpmn:documentation>Inspector tạo snapshot → submit → người có ADJUSTMENT.APPROVE/REJECT trong kho xét duyệt; không tự duyệt.
Approve dùng version + system_qty từ DB, không tin client. ADJUST_OUT không được giảm tồn dưới reserved hoặc dưới 0.
Commit gồm inventory + INSERT ledger + audit + APPROVED. Reject/cancel không thay đổi tồn.
Snapshot stale: 409, proposer hủy và lập mới; không tự tính lại delta. Submit/approve lỗi kỹ thuật có thể thử lại.</bpmn:documentation><bpmn:laneSet id="Lanes_adjustment_approval"><bpmn:lane id="Lane_0" name="Inspector / proposer"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>DraftInput</bpmn:flowNodeRef><bpmn:flowNodeRef>DraftRetry</bpmn:flowNodeRef><bpmn:flowNodeRef>SubmitInput</bpmn:flowNodeRef><bpmn:flowNodeRef>Stale</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="WH_MANAGER / reviewer"><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>ReviewRetry</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Hệ thống BE + DB"><bpmn:flowNodeRef>SaveDraft</bpmn:flowNodeRef><bpmn:flowNodeRef>DraftOK</bpmn:flowNodeRef><bpmn:flowNodeRef>SubmitCheck</bpmn:flowNodeRef><bpmn:flowNodeRef>SubmitOK</bpmn:flowNodeRef><bpmn:flowNodeRef>ReviewGuard</bpmn:flowNodeRef><bpmn:flowNodeRef>Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>Reject</bpmn:flowNodeRef><bpmn:flowNodeRef>Approve</bpmn:flowNodeRef><bpmn:flowNodeRef>Committed</bpmn:flowNodeRef><bpmn:flowNodeRef>EndApprove</bpmn:flowNodeRef><bpmn:flowNodeRef>EndReject</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Bắt đầu"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="DraftInput" name="Chọn inventoryId actualQty base + reason"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="SaveDraft" name="Quyền + scope + owner Snapshot identity/qty/version Lưu DRAFT"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="DraftOK" name="Hợp lệ?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="DraftRetry" name="Sửa dữ liệu đề xuất"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="SubmitInput" name="Rà soát / sửa DRAFT Gửi duyệt"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="SubmitCheck" name="Owner + DRAFT Kiểm tra snapshot PENDING_APPROVAL"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="SubmitOK" name="Snapshot đúng?"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Stale" name="409: Hủy đề xuất Kiểm đếm / lập phiếu mới"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Review" name="Xem chênh lệch / reason Approve hoặc Reject"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="ReviewGuard" name="Quyền đúng kho từ DB Reviewer ≠ proposer PENDING_APPROVAL"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Decision" name="Kết quả?"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Reject" name="Lưu rejection_reason Status REJECTED Không ghi movement"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Approve" name="Kiểm tra snapshot/reserved Tx: ADJUST_IN / OUT + tồn Audit + APPROVED"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Committed" name="Commit?"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing><bpmn:outgoing>Flow_19</bpmn:outgoing><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="ReviewRetry" name="Lỗi quyền/trạng thái/DB Tải lại; xử lý rồi thử lại"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="EndApprove" name="APPROVED"><bpmn:incoming>Flow_18</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="EndReject" name="REJECTED"><bpmn:incoming>Flow_21</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="DraftInput" name=""/><bpmn:sequenceFlow id="Flow_1" sourceRef="DraftInput" targetRef="SaveDraft" name="POST adjustments"/><bpmn:sequenceFlow id="Flow_2" sourceRef="SaveDraft" targetRef="DraftOK" name=""/><bpmn:sequenceFlow id="Flow_3" sourceRef="DraftOK" targetRef="SubmitInput" name="201; DRAFT"/><bpmn:sequenceFlow id="Flow_4" sourceRef="DraftOK" targetRef="DraftRetry" name="Lỗi"/><bpmn:sequenceFlow id="Flow_5" sourceRef="DraftRetry" targetRef="DraftInput" name="Sửa"/><bpmn:sequenceFlow id="Flow_6" sourceRef="SubmitInput" targetRef="SubmitCheck" name="POST submit"/><bpmn:sequenceFlow id="Flow_7" sourceRef="SubmitCheck" targetRef="SubmitOK" name=""/><bpmn:sequenceFlow id="Flow_8" sourceRef="SubmitOK" targetRef="Review" name="Có"/><bpmn:sequenceFlow id="Flow_9" sourceRef="SubmitOK" targetRef="Stale" name="409: stale"/><bpmn:sequenceFlow id="Flow_10" sourceRef="Stale" targetRef="DraftInput" name="Cancel + tạo mới"/><bpmn:sequenceFlow id="Flow_11" sourceRef="Review" targetRef="ReviewGuard" name="POST approve / reject"/><bpmn:sequenceFlow id="Flow_12" sourceRef="ReviewGuard" targetRef="Decision" name=""/><bpmn:sequenceFlow id="Flow_13" sourceRef="Decision" targetRef="Approve" name="Approve"/><bpmn:sequenceFlow id="Flow_14" sourceRef="Decision" targetRef="Reject" name="Reject + reason"/><bpmn:sequenceFlow id="Flow_15" sourceRef="Decision" targetRef="ReviewRetry" name="Lỗi quyền / trạng thái"/><bpmn:sequenceFlow id="Flow_16" sourceRef="ReviewRetry" targetRef="Review" name="Thử lại"/><bpmn:sequenceFlow id="Flow_17" sourceRef="Approve" targetRef="Committed" name=""/><bpmn:sequenceFlow id="Flow_18" sourceRef="Committed" targetRef="EndApprove" name="Có"/><bpmn:sequenceFlow id="Flow_19" sourceRef="Committed" targetRef="Stale" name="409: stale"/><bpmn:sequenceFlow id="Flow_20" sourceRef="Committed" targetRef="ReviewRetry" name="Rollback / lỗi khác"/><bpmn:sequenceFlow id="Flow_21" sourceRef="Reject" targetRef="EndReject" name="Không đổi tồn"/></bpmn:process><bpmndi:BPMNDiagram id="Diagram_adjustment_approval"><bpmndi:BPMNPlane id="Plane_adjustment_approval" bpmnElement="Collaboration_adjustment_approval"><bpmndi:BPMNShape id="Shape_Pool" bpmnElement="Pool_adjustment_approval" isHorizontal="true"><dc:Bounds x="0" y="115" width="3000" height="570"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_0" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="30" y="115" width="2970" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_1" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="30" y="305" width="2970" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_2" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="30" y="495" width="2970" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="140" y="175" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="95" y="216" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_DraftInput" bpmnElement="DraftInput"><dc:Bounds x="210" y="145" width="210" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_SaveDraft" bpmnElement="SaveDraft"><dc:Bounds x="470" y="520" width="210" height="84"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_DraftOK" bpmnElement="DraftOK" isMarkerVisible="true"><dc:Bounds x="725" y="530" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="680" y="505" width="140" height="20"/></bpmndi:BPMNLabel></bpmndi:BP