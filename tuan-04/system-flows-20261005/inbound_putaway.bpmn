<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_inbound_putaway" targetNamespace="https://laztar/wms/design"><bpmn:collaboration id="Collaboration_inbound_putaway"><bpmn:participant id="Pool_inbound_putaway" name="BPMN — Nhập hàng và cất hàng" processRef="Process_inbound_putaway"/></bpmn:collaboration><bpmn:process id="Process_inbound_putaway" isExecutable="false"><bpmn:documentation>Thiết kế hệ thống theo bộ tài liệu 05/10 + contract tuần 3 phần Nam; mỗi dòng nhận/cất một lần.
Service task transaction: status + receipt_lines + inventory + INSERT ledger cùng commit; lỗi rollback toàn bộ thao tác.
Lỗi trả về để sửa/thử lại; phiếu không tự CANCELLED. 409 do trạng thái: tải lại phiếu trước khi tiếp tục.
Lot / serial / expiry theo policy SKU; quantity quy đổi base UOM; giữ cùng scope kho và người được giao.</bpmn:documentation><bpmn:laneSet id="Lanes_inbound_putaway"><bpmn:lane id="Lane_0" name="Supervisor"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Create</bpmn:flowNodeRef><bpmn:flowNodeRef>CreateRetry</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Receiver"><bpmn:flowNodeRef>Receive</bpmn:flowNodeRef><bpmn:flowNodeRef>ReceiveRetry</bpmn:flowNodeRef><bpmn:flowNodeRef>Putaway</bpmn:flowNodeRef><bpmn:flowNodeRef>PutawayRetry</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Hệ thống BE + DB"><bpmn:flowNodeRef>CheckCreate</bpmn:flowNodeRef><bpmn:flowNodeRef>CreateOK</bpmn:flowNodeRef><bpmn:flowNodeRef>CheckReceive</bpmn:flowNodeRef><bpmn:flowNodeRef>ReceiveOK</bpmn:flowNodeRef><bpmn:flowNodeRef>ReceiveTx</bpmn:flowNodeRef><bpmn:flowNodeRef>ReceiveCommit</bpmn:flowNodeRef><bpmn:flowNodeRef>CheckPutaway</bpmn:flowNodeRef><bpmn:flowNodeRef>PutawayOK</bpmn:flowNodeRef><bpmn:flowNodeRef>PutawayTx</bpmn:flowNodeRef><bpmn:flowNodeRef>PutawayCommit</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Bắt đầu"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Create" name="Tạo / giao phiếu Kho, NCC, SKU, UOM"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="CheckCreate" name="Xác thực + quyền/scope Master active; Receiver hợp lệ Lưu NEW / ASSIGNED"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="CreateOK" name="Hợp lệ?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="CreateRetry" name="Sửa dữ liệu / giao Receiver NEW chưa được receive"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Receive" name="Nhập qty, lot/serial/expiry Chọn BIN RECEIVING"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="CheckReceive" name="ASSIGNED + đúng assignee BIN/kho; policy; qty ≤ dự kiến Quy đổi Decimal, snapshot"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="ReceiveOK" name="Hợp lệ?"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="ReceiveTx" name="Transaction nhận RECEIPT +base qty Status RECEIVED"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="ReceiveCommit" name="Commit?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="ReceiveRetry" name="Đọc lỗi / tải lại phiếu Sửa dữ liệu hoặc thử lại"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Putaway" name="Chọn BIN STORAGE Cất toàn bộ lượng đã nhận"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="CheckPutaway" name="RECEIVED + assignee/scope BIN active cùng kho Tồn RECEIVING đủ"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="PutawayOK" name="Hợp lệ?"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="PutawayTx" name="Transaction cất PUTAWAY_OUT / IN Status COMPLETED"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgo