@startuml ERD_Domain_B_Warehouse_Structure

title Domain B - Warehouse Structure

hide circle
skinparam linetype ortho

' =========================================================
' WAREHOUSES
' =========================================================

entity warehouses {
    * id         : BIGINT <<PK>>
    --
    * code       : VARCHAR(20) <<UK>>
    * name       : VARCHAR(100)
    address      : VARCHAR(255)
    * status     : VARCHAR(20)
    --
    * created_at : TIMESTAMP
    * created_by : BIGINT
    * updated_at : TIMESTAMP
    * updated_by : BIGINT
}

' =========================================================
' LOCATIONS (Zone -> Aisle -> Rack -> Bin, tự tham chiếu)
' =========================================================

entity locations {
    * id            : BIGINT <<PK>>
    --
    * warehouse_id  : BIGINT <<FK>>
    parent_id       : BIGINT <<FK, nullable>>
    * location_type : VARCHAR(10)
    * code          : VARCHAR(50)
    * name          : VARCHAR(100)
    * full_path     : VARCHAR(255)
    * purpose       : VARCHAR(20)
    max_weight      : DECIMAL(18,4)
    max_volume      : DECIMAL(18,4)
    * is_pickable   : BOOLEAN
    * is_active     : BOOLEAN
    --
    * created_at    : TIMESTAMP
    * created_by    : BIGINT
    * updated_at    : TIMESTAMP
    * updated_by    : BIGINT
}

note right of locations
  UNIQUE (warehouse_id, code)
  UNIQUE (warehouse_id, full_path)

  location_type:
  ZONE | AISLE | RACK | BIN

  purpose:
  RECEIVING | STORAGE | PICKING |
  STAGING | QC | DAMAGED

  Rules:
  - parent phải thuộc cùng warehouse
  - hierarchy: ZONE -> AISLE -> RACK -> BIN
  - inventory chỉ tham chiếu location_type = BIN
  - không deactivate location còn tồn kho
  - QC/DAMAGED không tính vào sellable availability
end note

' =========================================================
' RELATIONSHIPS
' =========================================================

warehouses ||--o{ locations : "warehouse_id"
locations  |o--o{ locations : "parent_id"

@enduml
